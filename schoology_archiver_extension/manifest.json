{
  "manifest_version": 3,
  "name": "Schoology Course Archiver",
  "version": "1.1.0",
  "description": "Archive a Schoology course (files, Google Docs, assignments, your submissions, grades) into your Downloads folder, with an INDEX.md for AI study tools.",
  "action": {
    "default_title": "Open Schoology Archiver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "downloads.ui",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.schoology.com/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "commands": {
    "kill-archiver": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Stop the Schoology archiver immediately"
    }
  },
  "side_panel": {
    "default_path": "archive.html"
  }
}
