{
  "manifest_version": 3,
  "name": "Schoology Course Archiver",
  "version": "1.11.0",
  "minimum_chrome_version": "116",
  "description": "Archive a Schoology course (files, Google Docs, assignments, your submissions, grades) into your Downloads folder, with an INDEX.md for AI study tools.",
  "action": {
    "default_title": "Schoology Archiver settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "downloads.ui",
    "storage",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.schoology.com/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://neo-plan.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.schoology.com/*"
      ],
      "exclude_matches": [
        "https://*.schoology.com/*assessment*",
        "https://*.schoology.com/assignment/*/dropbox*"
      ],
      "js": [
        "overlays/theme-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.schoology.com/*"
      ],
      "exclude_matches": [
        "https://*.schoology.com/*assessment*",
        "https://*.schoology.com/assignment/*/dropbox*"
      ],
      "js": [
        "overlays/boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlays/archive.js",
        "overlays/asgstate.js",
        "overlays/assignment.js",
        "overlays/course.js",
        "overlays/coursedata.js",
        "overlays/coursetodo.js",
        "overlays/grademath.js",
        "overlays/grades.js",
        "overlays/home.js",
        "overlays/launcher.js",
        "overlays/marker.js",
        "overlays/marks.js",
        "overlays/materials.js",
        "overlays/matstate.js",
        "overlays/switch.js",
        "overlays/theme.js",
        "overlays/todo.js",
        "overlays/todorows.js",
        "overlays/ui.js",
        "overlays/fonts/*.woff2",
        "outputs/archive/state.js",
        "reader/md.js",
        "reader/ratelimit.js",
        "reader/parse/grades.js",
        "reader/parse/materials.js",
        "reader/parse/sync.js",
        "util.js",
        "panel/today-format.js",
        "panel/settings.html",
        "panel/settings.js",
        "panel/settings.css",
        "panel/sync-settings.js",
        "panel/np.js",
        "panel/fonts/*.woff2"
      ],
      "matches": [
        "https://*.schoology.com/*"
      ]
    }
  ],
  "commands": {
    "kill-archiver": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Stop the Schoology archiver immediately"
    }
  },
  "options_ui": {
    "page": "panel/settings.html",
    "open_in_tab": true
  }
}
